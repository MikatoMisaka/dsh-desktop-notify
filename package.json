{
  "name": "dsh-desktop-notify",
  "version": "0.5.0",
  "private": true,
  "description": "DSH 桌面通知：任务完成、需要你选择/确认时弹出 Windows 通知（操作中心可见），点通知直接回到对应会话",
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build:focus": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-focus.ps1",
    "protocol:install": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/install-protocol.ps1",
    "protocol:uninstall": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/install-protocol.ps1 -Uninstall",
    "setup": "npm run build:focus && npm run protocol:install",
    "test": "node client-selftest.mjs",
    "test:live": "node client-selftest.mjs && node selftest.mjs"
  },
  "files": [
    "lib",
    "bin",
    "scripts",
    "native",
    "selftest.mjs",
    "client-selftest.mjs",
    "cordis.patch.yml",
    "README.md"
  ],
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "notification",
    "windows-toast"
  ],
  "license": "MIT",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": []
    }
  }
}
